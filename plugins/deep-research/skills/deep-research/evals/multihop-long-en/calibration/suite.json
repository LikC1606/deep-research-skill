{
  "schema_version": 1,
  "id": "multihop-long-en-judge-calibration-v1",
  "case": "../case.json",
  "criteria": [
    {
      "id": "C01",
      "requirement": "Identify the requested deployable object through the alias, archive and artifact-register chain, preserving package, digest and persistence-mode identity; a sealed handoff is not workload-gate passage."
    },
    {
      "id": "C02",
      "requirement": "Use the corrected billable all-worker CPU means per accepted clean/retry job, including failed attempts and persistence work exactly once."
    },
    {
      "id": "C03",
      "requirement": "Calculate the matching workload-weighted CPU means and monthly CPU hours with accepted-job denominators, explicit units and the correct CPU-time conversion."
    },
    {
      "id": "C04",
      "requirement": "Calculate both monthly CPU-plus-queue-license totals under the applicable September schedule, including the candidate's fixed license fee."
    },
    {
      "id": "C05",
      "requirement": "Calculate relative savings in total monthly CPU-plus-license spending against B-11, distinguishing this percentage from the CPU-only reduction."
    },
    {
      "id": "C06",
      "requirement": "Apply CT-91's monthly cost gate to the matching total costs, state the corresponding dollar ceiling and correctly decide whether the candidate passes."
    },
    {
      "id": "C07",
      "requirement": "Preserve the latency measurement identity by distinguishing worker service-time p95 from the corrected pooled steady-state queue-residence p95 for the matching workload."
    },
    {
      "id": "C08",
      "requirement": "Apply CT-91's queue-residence p95 threshold to the matching corrected statistic and correctly decide whether the candidate passes."
    },
    {
      "id": "C09",
      "requirement": "Represent S5's actual provenance, distinguishing a reproduced pre-correction excerpt from an independent new measurement or independent corroboration."
    },
    {
      "id": "C10",
      "requirement": "State what the complete supplied corpus establishes about an independent security-certification identifier; preserve an evidence gap rather than inventing a determined identifier or inferring nonexistence from absence."
    },
    {
      "id": "C11",
      "requirement": "State what the complete supplied corpus establishes about the contractual queue-record storage region; preserve an evidence gap rather than inventing a determined region or treating a benchmark location as a commitment."
    },
    {
      "id": "C12",
      "requirement": "Give a bounded approval recommendation consistent with the gate evidence, treating a follow-up experiment as proposed work and avoiding a future production guarantee."
    }
  ],
